generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // trocar para "postgresql" quando precisar
  url      = env("DATABASE_URL")
}

model Story {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  events      Event[]
  characters  Character[]

  @@index([deletedAt])
}

model Character {
  id         String    @id @default(cuid())
  storyId    String
  story      Story     @relation(fields: [storyId], references: [id])
  name       String
  nickname   String    @default("")
  // Ficha completa; os campos válidos estão em packages/shared/src/characterFields.ts.
  attributes Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  events     Event[]

  @@index([storyId])
}

model Event {
  id          String    @id @default(cuid())
  storyId     String
  story       Story     @relation(fields: [storyId], references: [id])
  title       String
  description String    @default("")
  date        DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  characters  Character[]

  @@index([storyId, date])
}
